+
+/*
+ * songyuan: pmap 就绪后再映射帧缓冲（bsd_init 之前调用）。
+ * 注意：这里先不清屏，只打印映射结果——清屏在真机上曾触发只读页写错误。
+ */
+void sweet_fbcon_late_init(void);
+
+void
+sweet_fbcon_late_init(void)
+{
+	if (fbcon_base != NULL || fbcon_pa == 0) {
+		return;
+	}
+	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(fbcon_pa, fbcon_sz);
+	if (fbcon_base != NULL) {
+		fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
+		fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
+		fbcon_col = fbcon_row = 0;
+		printf("[fbcon] mapped pa=0x%llx size=0x%llx base=%p %ux%u stride=%u\n",
+		    (unsigned long long)fbcon_pa, (unsigned long long)fbcon_sz,
+		    (void *)fbcon_base, fbcon_width, fbcon_height, fbcon_stride);
+	} else {
+		printf("[fbcon] mapping FAILED pa=0x%llx size=0x%llx\n",
+		    (unsigned long long)fbcon_pa, (unsigned long long)fbcon_sz);
+	}
+}
