--- a/osfmk/arm64/songyuan_log.c
+++ b/osfmk/arm64/songyuan_log.c
@@ -8,6 +8,9 @@
  * 物理地址 = 符号 VA - __TEXT vmaddr(0xfffffff007004000) + physBase。
  */
 #include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <kern/thread.h>
+#include <mach/clock_types.h>
 
 #define SONGYUAN_LOG_SIZE (512 * 1024)
 
@@ -63,2 +66,50 @@
 	__asm__ volatile("dmb oshst" ::: "memory");
 }
+
+/*
+ * The watchdog that resets this phone is the Qualcomm hypervisor's virtual one
+ * (Gunyah), not the qcom,wdt@17600000 register window: Android feeds it with an
+ * SMC call and the timeout is at most 65 s.  Petting it every 5 s keeps a
+ * healthy kernel alive as long as it needs, and a hung kernel is still reset.
+ *
+ * Function id and call shape from hackios-xnu-kernel
+ * osfmk/arm64/loader_return.c (hv_wdt_pet).
+ */
+#define VIRT_WDT_PET    0x86000007u
+
+static void
+sweet_vwdt_pet(void)
+{
+	register uint64_t x0 __asm__("x0") = VIRT_WDT_PET;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17");
+}
+
+static void
+sweet_wdt_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static event_t wq;
+
+	(void)arg;
+	(void)wr;
+	for (;;) {
+		sweet_ramoops_save();
+		sweet_vwdt_pet();
+		assert_wait_timeout(&wq, THREAD_INTERRUPTIBLE, 5000, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+sweet_wdt_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(sweet_wdt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
