--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -867,4 +867,142 @@ IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService **targetP, UInt32 index)
 	*targetP = this;
 	return &sweet_surface_traps[index];
 }
+#if defined(SONGYUAN)
+/*
+ * SONGYUAN SCREEN CONSOLE.
+ *
+ * The panel mapping AppleCLCD holds (fPixels, an IOMemoryDescriptor mapping) is the
+ * only writable one on this board: the ml_io_map_wcomb mapping fbcon uses returns an
+ * address that faults, which is why this kernel has never painted the phone screen.
+ * Here the console log ring is drawn straight into the panel through that working
+ * mapping, so the phone shows its own boot log with no USB link, no UFS write and no
+ * fbcon. Nothing is drawn before AppleCLCD::start; there the whole ring (last 4 MiB)
+ * is replayed, so the backlog from before IOKit appears as well.
+ */
+extern "C" unsigned char iso_font[256 * 16];
+extern "C" uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern "C" uint64_t sweet_log_position(void);
+
+#define SWEET_CON_RING      (4u << 20)
+#define SWEET_CON_FG        0x00d8d8d8u
+#define SWEET_CON_BG        0x00000000u
+#define SWEET_CON_HEADER    0x00204060u
+
+static struct {
+	uintptr_t base;
+	uint32_t  width, height, stride;
+	uint32_t  col, row, cols, rows;
+	uint64_t  pos;
+	bool      ready;
+} sweet_con;
+
+static void
+sweet_con_rows(uint32_t y0, uint32_t y1, uint32_t color)
+{
+	uint32_t words = sweet_con.stride / 4;
+	for (uint32_t y = y0; y < y1 && y < sweet_con.height; y++) {
+		volatile uint32_t *line = (volatile uint32_t *)sweet_con.base + (uint64_t)y * words;
+		for (uint32_t x = 0; x < sweet_con.width; x++) {
+			line[x] = color;
+		}
+	}
+}
+
+static void
+sweet_con_scroll(void)
+{
+	uint32_t words = sweet_con.stride / 4;
+	uint32_t y;
+	for (y = 0; y + 16 < sweet_con.height; y++) {
+		volatile uint32_t *dst = (volatile uint32_t *)sweet_con.base + (uint64_t)y * words;
+		volatile uint32_t *src = (volatile uint32_t *)sweet_con.base + (uint64_t)(y + 16) * words;
+		for (uint32_t x = 0; x < words; x++) {
+			dst[x] = src[x];
+		}
+	}
+	sweet_con_rows(y, sweet_con.height, SWEET_CON_BG);
+}
+
+static void
+sweet_con_newline(void)
+{
+	sweet_con.col = 0;
+	if (++sweet_con.row >= sweet_con.rows) {
+		sweet_con_scroll();
+		sweet_con.row = sweet_con.rows - 1;
+	}
+}
+
+static void
+sweet_con_putc(char c)
+{
+	if (sweet_con.base == 0 || !sweet_con.ready) {
+		return;
+	}
+	if (c == '\r') {
+		sweet_con.col = 0;
+		return;
+	}
+	if (c == '\n') {
+		sweet_con_newline();
+		return;
+	}
+	if ((unsigned char)c < 0x20 || (unsigned char)c > 0x7e) {
+		c = ' ';
+	}
+	if (sweet_con.col >= sweet_con.cols) {
+		sweet_con_newline();
+	}
+	uint32_t words = sweet_con.stride / 4;
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	volatile uint32_t *px = (volatile uint32_t *)sweet_con.base
+	    + (uint64_t)(sweet_con.row * 16) * words + (uint64_t)sweet_con.col * 8;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		volatile uint32_t *line = px + (uint64_t)gy * words;
+		unsigned int bits = glyph[gy];
+		for (uint32_t gx = 0; gx < 8; gx++) {
+			line[gx] = (bits & (0x80u >> gx)) ? SWEET_CON_FG : SWEET_CON_BG;
+		}
+	}
+	sweet_con.col++;
+}
+
+/* Called for every console byte from loader_log_putc (osfmk/arm64/songyuan_log.c). */
+extern "C" void
+sweet_fb_console_byte(char c)
+{
+	sweet_con_putc(c);
+}
+
+extern "C" void
+sweet_fb_console_start(uintptr_t base, uint32_t width, uint32_t height, uint32_t stride)
+{
+	char buf[256];
+	uint32_t n;
+
+	sweet_con.base = base;
+	sweet_con.width = width;
+	sweet_con.height = height;
+	sweet_con.stride = stride;
+	sweet_con.cols = width / 8;
+	sweet_con.rows = height / 16;
+	sweet_con.col = 0;
+	sweet_con.row = 0;
+	sweet_con.ready = false;
+	sweet_con_rows(0, height, SWEET_CON_BG);
+	sweet_con_rows(0, 24, SWEET_CON_HEADER);
+	sweet_con.pos = sweet_log_position();
+	if (sweet_con.pos > SWEET_CON_RING) {
+		sweet_con.pos -= SWEET_CON_RING;
+	} else {
+		sweet_con.pos = 0;
+	}
+	sweet_con.ready = true;
+	while ((n = sweet_log_copy(&sweet_con.pos, buf, sizeof(buf))) > 0) {
+		for (uint32_t i = 0; i < n; i++) {
+			sweet_con_putc(buf[i]);
+		}
+	}
+}
+#endif
 #endif /* SWEET */
