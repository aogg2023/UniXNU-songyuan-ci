+/*
+ * Console over the ACM bulk IN endpoint.  Every 50 ms the new bytes of the kernel
+ * console ring go to the host as they are; a dropped chunk is better than a stall.
+ */
+static volatile bool ud_console_run;
+static void
+ud_console_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[512];
+	extern uint32_t sweet_log_copy(uint64_t *, char *, uint32_t);
+	extern uint64_t sweet_log_position(void);
+	uint64_t pos = sweet_log_position();
+
+	if (pos > 32768) {
+		pos -= 32768;
+	} else {
+		pos = 0;
+	}
+	while (ud_console_run) {
+		ud_sleep_ms(50);
+		if (!ud.configured) {
+			continue;
+		}
+		uint32_t n = sweet_log_copy(&pos, chunk, sizeof(chunk));
+		if (n == 0) {
+			continue;
+		}
+		lck_mtx_lock(ud.lock);
+		if (!ud.tx_busy) {
+			memcpy((void *)(ud.dma + UD_TX), chunk, n);
+			ud.tx_busy = true;
+			ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, n, TRBCTL_NORMAL);
+		}
+		lck_mtx_unlock(ud.lock);
+	}
+}
