 __startup_func
 static void
 PE_init_kprintf_config(void)
@@ -159,8 +160,9 @@
 	if (c == '\n') {
 		uart_putc('\r');
 	}
 	uart_putc(c);
+	loader_log_putc(c);
 }
 
 void
 serial_putc_options(char c, bool poll)
