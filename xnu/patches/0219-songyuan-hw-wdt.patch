  */
 extern void panic(const char *, ...) __printflike(1, 2) __dead2;
 
-static event_t sweet_deadman_wq;
+/*
+ * Qualcomm MSM watchdog (DT qcom,msm-watchdog @ 0x17600000, downstream register
+ * layout: RST 0x4, EN 0x8, BITE 0x14).  Armed for the maximum at 32.768 kHz
+ * (0xfffff ticks ~ 32 s).  The snapshot thread pets it every 2 s; if the kernel
+ * stops running that thread, the hardware resets the SoC by itself.
+ */
+#define WDT_PA          0x17600000
+#define WDT_RST         0x04
+#define WDT_EN          0x08
+#define WDT_BITE        0x14
+#define WDT_MAX_TICKS   0xfffff
+
+static volatile uint32_t *sweet_wdt;
+
+void
+sweet_wdt_arm(void)
+{
+	vm_offset_t va = ml_io_map(WDT_PA, 0x1000);
+
+	if (va == 0) {
+		return;
+	}
+	sweet_wdt = (volatile uint32_t *)va;
+	sweet_wdt[WDT_EN / 4] = 0;
+	sweet_wdt[WDT_BITE / 4] = WDT_MAX_TICKS;
+	sweet_wdt[WDT_EN / 4] = 1;
+}
 
+/* Snapshot the console log into ramoops and pet the watchdog, every 2 s. */
 static void
 sweet_deadman_thread(void *arg __unused, wait_result_t wr __unused)
 {
-	int seconds = 90;
+	static event_t wq;
 
-	PE_parse_boot_argn("sweetdeadman", &seconds, sizeof(seconds));
-	if (seconds <= 0) {
-		seconds = 90;
+	sweet_wdt_arm();
+	for (;;) {
+		sweet_ramoops_save();
+		if (sweet_wdt != NULL) {
+			sweet_wdt[WDT_RST / 4] = 1;
+		}
+		assert_wait_timeout(&wq, THREAD_INTERRUPTIBLE, 2000, TIMEOUT_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
 	}
-	/* Sleep, do not spin: with cpus=1 a busy loop would starve the boot. */
-	assert_wait_timeout(&sweet_deadman_wq, THREAD_INTERRUPTIBLE, (uint32_t)seconds * 1000, TIMEOUT_MSEC);
-	thread_block(THREAD_CONTINUE_NULL);
-	sweet_ramoops_save();
-	panic("SONGYUAN: bring-up watchdog (%d s), log saved to ramoops", seconds);
 }
 
